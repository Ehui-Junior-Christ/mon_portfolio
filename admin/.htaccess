# ==========================================================================
#  Portail d'administration : en-têtes plus stricts (InfinityFree / Apache)
#  Ces « Header set » remplacent ceux du .htaccess racine pour /admin/.
#  Même CSP que la <meta> d'admin/index.html, plus frame-ancestors, et les
#  hash du style/script de 404.html (page d'erreur servie aussi sous /admin/).
# ==========================================================================
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-dSvqMunLC6Vbjy41ZrCcqGLxRQ2Fx95EiiM3WPRBQrc='; connect-src 'self' https://api.github.com; img-src 'self' data: blob: https:; style-src 'self' 'sha256-gjY+aLfhf4bA8NbvqLXFjM9i4Lbc9rgwSRTVitfY19Y=' https://fonts.googleapis.com https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/; media-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    # Aucune URL de l'admin ne fuit vers un autre site
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Le portail manipule un token : jamais de copie en cache (proxy, disque)
    Header set Cache-Control "no-store"
</IfModule>
